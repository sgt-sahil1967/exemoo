# Exemoo environment. On Vercel, set these in Project → Settings → Environment Variables.
# Locally: node --env-file=.env server/index.js  (the server does not read .env by itself).

# ── Pairing store (Vercel only) ───────────────────────────────────────────
# Added automatically when you connect an Upstash Redis database from the Vercel Marketplace.
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=...
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN work too.)

# ── Alpha sign-in (the gate is off while AUTH_SECRET is unset) ─────────────
# Long random string; changing it signs everyone out. e.g.  openssl rand -hex 32
# AUTH_SECRET=
# Who may sign in: emails, or @domain for a whole domain. Changing it needs a redeploy on Vercel.
# ALPHA_EMAILS=friend@example.com, other@example.com, @yourteam.com
# Resend (resend.com) API key and a sender on a domain you verified there. Without a key the
# sign-in link is only printed in the server log (fine locally).
# RESEND_API_KEY=re_...
# MAIL_FROM=Exemoo <alpha@yourdomain.com>
# Base URL used in sign-in emails (optional; defaults to the request's own host).
# PUBLIC_URL=https://exemoo.vercel.app

# ── Rooms ─────────────────────────────────────────────────────────────────
# How long a room waits for its screen to come back (reload, laptop sleep) before closing, ms.
# ROOM_GRACE_MS=300000

# ── Local Node server only ────────────────────────────────────────────────
# PORT=8080
# HOST=0.0.0.0
# EXEMOO_LAN=1               # same as --lan: self-signed HTTPS on HTTPS_PORT for phones on the LAN
# HTTPS_PORT=8443
# CSP=on                     # on | report-only | off
# LOG_FORMAT=text            # json | text
# LOG_LEVEL=debug
# EXEMOO_SWING_LOG=1         # accept POST /api/swings (cricket training data) outside LAN mode
