# Exemoo server environment. Copy to .env for local use (the server does not read .env itself:
# use `node --env-file=.env server/index.js`, or set these in Render / Docker / Fly).

# ── Basics ───────────────────────────────────────────────────────────────
NODE_ENV=production          # production → JSON logs, info level
PORT=8080                    # set by the host on Render/Fly
HOST=0.0.0.0
# Public base URL used in QR codes and pad links. Optional: without it the URL is taken from the
# request (X-Forwarded-Proto/Host behind a trusted proxy). Set it for a custom domain.
PUBLIC_URL=https://play.example.com
# Read client IP / proto / host from X-Forwarded-* (on automatically on Render and Fly).
TRUST_PROXY=1

# ── WebRTC / TURN (optional, recommended on the open internet) ────────────
# Without TURN, phones that cannot reach the screen directly use the server WebSocket relay.
# Either a static list of RTCIceServer…
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:turn.example.com:3478","turns:turn.example.com:5349"],"username":"u","credential":"p"}]
# …or coturn's REST API (use-auth-secret): the server hands out credentials valid for TURN_TTL_S.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_SECRET=change-me
# TURN_TTL_S=21600

# ── Security ──────────────────────────────────────────────────────────────
# Extra web origins allowed to open /signal (the page's own host is always allowed). '*' = any.
# ALLOWED_ORIGINS=https://exemoo.example.com
# Content-Security-Policy: on | report-only | off
CSP=on

# ── Rooms and limits ──────────────────────────────────────────────────────
# How long a room waits for its screen to come back (reload, laptop sleep) before closing, ms.
ROOM_GRACE_MS=300000
# A room with no screen and no traffic is reaped after this long, ms.
ROOM_IDLE_TTL_MS=1800000
MAX_SOCKETS=5000
MAX_ROOMS=10000

# ── Logging ───────────────────────────────────────────────────────────────
LOG_FORMAT=json              # json | text
LOG_LEVEL=info               # debug shows every pairing event

# ── Local / dev only ──────────────────────────────────────────────────────
# EXEMOO_LAN=1               # same as --lan: self-signed HTTPS on HTTPS_PORT for phones on the LAN
# HTTPS_PORT=8443
# EXEMOO_SWING_LOG=1         # accept POST /api/swings (cricket training data) outside LAN mode
